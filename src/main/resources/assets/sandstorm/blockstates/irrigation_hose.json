{
  "multipart": [
    {
      "apply": { "model": "sandstorm:block/irrigation_hose_core" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "sandstorm:block/irrigation_hose_side" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "sandstorm:block/irrigation_hose_side", "y": 90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "sandstorm:block/irrigation_hose_side", "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "sandstorm:block/irrigation_hose_side", "y": 270 }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "sandstorm:block/irrigation_hose_up" }
    }
  ]
}
