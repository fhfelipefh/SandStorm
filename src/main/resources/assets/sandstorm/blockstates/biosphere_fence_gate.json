{
  "multipart": [
    { "when": { "open": "false", "facing": "north" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate" } },
    { "when": { "open": "false", "facing": "south" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate", "y": 180 } },
    { "when": { "open": "false", "facing": "west" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate", "y": 270 } },
    { "when": { "open": "false", "facing": "east" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate", "y": 90 } },
    { "when": { "open": "true", "facing": "north" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate_open" } },
    { "when": { "open": "true", "facing": "south" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate_open", "y": 180 } },
    { "when": { "open": "true", "facing": "west" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate_open", "y": 270 } },
    { "when": { "open": "true", "facing": "east" }, "apply": { "model": "sandstorm:block/biosphere_fence_gate_open", "y": 90 } }
  ]
}
