{
  "multipart": [
    {
      "when": { "facing": "north" },
      "apply": { "model": "sandstorm:block/vault_door_controller" }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "sandstorm:block/vault_door_controller", "y": 180 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "sandstorm:block/vault_door_controller", "y": 270 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "sandstorm:block/vault_door_controller", "y": 90 }
    }
  ]
}
